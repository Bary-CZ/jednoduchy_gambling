# Ignore Visual Studio temporary files, build results, and files generated by popular Visual Studio add-ons.
# Ignore the .vs directory (Visual Studio user-specific settings)
.vs/

# Build results
[Dd]ebug/
[Dd]ebugPublic/
# [Rr]elease/
[Rr]eleases/
x64/
x86/
[Bb]uild/
[Bb]in/
[Oo]bj/
[Ll]og/

# User-specific files
*.user
*.suo
*.userprefs
*.lock.json

# ReSharper files
_ReSharper.*
*.sln.iml

# MSTest test results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml

# Build results of Visual Studio projects
*.csproj.user
*.csproj.*

# NuGet Packages
*.nupkg
packages/

# NuGet Symbol Packages
*.snupkg

# Visual Studio cache/options directory
.vs/
.vscode/
.vs/haleluja/

# Microsoft Azure Web App publish settings
*.Publish.xml

# Local History for Visual Studio
.localhistory/

# Backup folder for Package Reference Convert tool in Visual Studio 2017
MigrationBackup/

